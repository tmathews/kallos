#!/usr/bin/env bash
# Kallos — one command to set a machine up, and the same command to update it.
#
#   git clone --recursive git@github.com:tmathews/kallos.git
#   cd kallos && ./kallos
#
# That is the whole fresh-Arch story: install the system packages, build muon
# from source, check out every submodule, build the suite, install it. Run it
# again next week and it updates instead. There is no separate `init` because
# `up` is idempotent — the only difference between a new machine and an old one
# is how much of it is already done.
#
# This file is a DISPATCHER. It owns argument parsing, the ordering of the
# phases, and the three guards below; it owns no build knowledge. The real work
# lives in scripts/, which stays independently runnable:
#
#   scripts/lib/out.sh     the shared output vocabulary
#   scripts/lib/detect.sh  what this machine is: init, seat backend, packaging
#   scripts/deps.sh     packages + muon                (this repo)
#   scripts/sync.sh     the submodule engine           (this repo)
#   scripts/build.sh    kosmos via muon, then cargo       (predates this file)
#   scripts/install.sh  copy into $PREFIX              (predates this file)
#   scripts/session.sh  the login screen + boot GPU    (this repo)
#   scripts/verify.sh   23 checks, no sudo, no TTY     (predates this file)
#
# Usage: ./kallos [subcommand] [flags]     (default subcommand: up)
set -euo pipefail
cd "$(dirname "$0")"
root="$PWD"
. "$root/scripts/lib/out.sh"

CFG=release
APPS=0
DRY=0
do_deps=1 do_install=1 do_session=1 do_verify=1 do_pull=0 latest=0 do_pin=0
PREFIX="${PREFIX:-/usr/local}"

usage() {
	sed -n '2,20p' "$0" | sed 's/^# \?//'
	cat <<'EOF'

Subcommands
  up            deps -> sync -> build -> install -> session -> verify  [default]
  status        where every submodule is: branch, dirty, ahead/behind, pin
  sync          move the submodules to the recorded pins
  pin [-m MSG]  record where the submodules are now
  push          publish every submodule, so the pins are clonable
  deps          system packages and muon, nothing else
  session       the login screen (greetd + phylax) and the boot-time GPU it
                depends on. Checks both and OFFERS to fix each; nothing
                happens without a `y`, and declining is always an option
  boot [MODE]   the boot configuration: kernel flags, initramfs, loader
                timeout. check (default) | apply | revert. Opt-in and never
                part of `up` — it edits /etc and /boot and needs a reboot
  net [MODE]    the network a fresh install needs: networkd, resolved, iwd,
                DHCP config and the resolv.conf stub symlink that stops
                captive-portal logins hanging. check (default) | apply |
                revert. Opt-in and never part of `up` — it edits /etc
  doctor        preflight only — reports, writes nothing
  build|install|verify   pass straight through to scripts/

Flags
  --latest      sync to each submodule's origin/main instead of the pins
  --pin         with --latest, record the new pins afterwards
  --pull        git pull --ff-only the superproject first
  --apps        also build/install yggdrasil, torrential and renzoku
  --debug       build the debug config (default: release)
  --release     build the release config
  --prefix=P    install prefix (default /usr/local; a user prefix needs no sudo)
  --no-deps --no-install --no-session --no-verify
  -n, --dry-run report what sync would do; touch nothing
EOF
}

# ---- guards ---------------------------------------------------------------

# Running the whole thing under sudo is the classic way to break this tree:
# cargo would leave root-owned target/ directories behind and the next
# unprivileged build fails on them. scripts/build.sh's header says the same;
# this makes it impossible rather than documented.
[ "${EUID:-$(id -u)}" -ne 0 ] || {
	err "don't run this under sudo — cargo would leave root-owned target/ dirs"
	die "run it as yourself; the install step asks for sudo on its own."
}

# scripts/install.sh looks for each binary at $root/<crate>/target/$cfg/<crate>.
# A CARGO_TARGET_DIR in the environment moves them somewhere else and the
# install fails a preflight that reads like a build failure.
[ -z "${CARGO_TARGET_DIR:-}" ] || {
	err "CARGO_TARGET_DIR is set ($CARGO_TARGET_DIR)"
	die "scripts/install.sh expects binaries under each crate's own target/."
}

# ---- args -----------------------------------------------------------------
sub=""
args=()
while [ $# -gt 0 ]; do
	case "$1" in
		--latest)    latest=1 ;;
		--pin)       do_pin=1 ;;
		--pull)      do_pull=1 ;;
		--apps)      APPS=1 ;;
		--debug)     CFG=debug ;;
		--release)   CFG=release ;;
		--prefix=*)  PREFIX="${1#--prefix=}" ;;
		--no-deps)   do_deps=0 ;;
		--no-install) do_install=0 ;;
		--no-session) do_session=0 ;;
		--no-verify) do_verify=0 ;;
		-n|--dry-run) DRY=1 ;;
		-h|--help)   usage; exit 0 ;;
		-m)          args+=(-m "${2-}"); shift ;;   # `pin -m MSG`
		debug|release) CFG="$1" ;;
		-*) err "unknown flag: $1 (try --help)"; exit 2 ;;
		*)  if [ -z "$sub" ]; then sub="$1"; else args+=("$1"); fi ;;
	esac
	shift
done
sub="${sub:-up}"
export APPS DRY PREFIX

# ---- phases ---------------------------------------------------------------

phase_deps() {
	[ "$do_deps" = 1 ] || return 0
	# Each script prints its own header — they stay independently runnable, so
	# the announcement belongs with the work, not with the dispatcher.
	APPS="$APPS" "$root/scripts/deps.sh" install
}

phase_sync() {
	# --pull is a no-op until the superproject has a commit and a remote, which
	# is the state during the migration and on any tree that was never pushed.
	if [ "$do_pull" = 1 ] &&
	   git rev-parse --verify -q HEAD >/dev/null &&
	   git remote get-url origin >/dev/null 2>&1; then
		git pull --ff-only
	fi
	if [ "$latest" = 1 ]; then
		"$root/scripts/sync.sh" sync --latest
		if [ "$do_pin" = 1 ] && [ "$DRY" != 1 ]; then
			"$root/scripts/sync.sh" pin -m "bump submodules"
		fi
	else
		"$root/scripts/sync.sh" sync
	fi
}

phase_build() {
	# The config is passed EXPLICITLY to both halves and always will be:
	# scripts/build.sh defaults to debug and scripts/install.sh defaults to
	# release, so the bare pair builds one thing and installs another.
	APPS="$APPS" "$root/scripts/build.sh" "$CFG"
}

phase_install() {
	[ "$do_install" = 1 ] || return 0
	# A system prefix needs root; a user prefix (or a DESTDIR stage) does not.
	# Only the copy runs privileged — never the build above it.
	if [ -w "$PREFIX" ] || [ -n "${DESTDIR:-}" ]; then
		APPS="$APPS" PREFIX="$PREFIX" "$root/scripts/install.sh" "$CFG"
	else
		sudo APPS="$APPS" PREFIX="$PREFIX" "$root/scripts/install.sh" "$CFG"
	fi
}

# The login screen and the boot-time GPU. After install, deliberately: the
# greetd config it offers names `phylax-greeter`, which the install is what
# puts on PATH — offering to arm a login screen whose greeter does not exist
# yet would move the failure to the next boot.
#
# Safe to have in `up` because it is a no-op once done: everything it touches
# is checked first, and a machine that is already set up prints two OK lines
# and asks nothing. A user prefix has no business editing /etc, so it is
# skipped there rather than prompting for a sudo the rest of that run avoided.
phase_session() {
	[ "$do_session" = 1 ] || return 0
	[ "$DRY" != 1 ] || return 0
	if [ -n "${DESTDIR:-}" ] || [ "$PREFIX" != /usr/local ]; then
		hdr "session"
		skip "not a system prefix — /etc is left alone"
		return 0
	fi
	PREFIX="$PREFIX" "$root/scripts/session.sh" apply
}

verify_failed=0
phase_verify() {
	[ "$do_verify" = 1 ] || return 0
	# verify.sh claims the real session bus names, so it refuses to run next to
	# a live session — and being mid-session is the normal case for an update.
	# Skip rather than fail; it stays available by hand.
	if pgrep -x kosmos >/dev/null 2>&1; then
		hdr "verify"
		skip "a session is running — run scripts/verify.sh $CFG later"
		return 0
	fi
	hdr "verify"
	# Deliberately not fatal here. By this point the build and the install have
	# already succeeded, and aborting would suggest they hadn't. The session
	# checks are timing-sensitive on a cold cache — a first run on a new machine
	# can lose the overlay-spawn race — so report it and let the exit status
	# carry the bad news rather than swallowing the rest of the run.
	"$root/scripts/verify.sh" "$CFG" || verify_failed=1
}

cmd_doctor() {
	hdr "doctor"
	local bad=0
	for t in git cargo rustc clang pkg-config muon; do
		if command -v "$t" >/dev/null; then
			row_grn OK "$t" "$(command -v "$t")"
		else
			row_red MISS "$t" "not on PATH"; bad=1
		fi
	done
	if [ -f .gitmodules ]; then
		row_grn OK submodules "$(grep -c '^\[submodule' .gitmodules) registered"
	else
		row_red MISS submodules "this tree is not a superproject yet"; bad=1
	fi
	# Probe the transport, not a particular repo: the superproject's own remote
	# may legitimately not exist yet, and `ls-remote` on a missing repo fails
	# identically to a missing key. `ssh -T git@github.com` exits 1 even on
	# success, so match the greeting instead of the status — and swallow that
	# exit inside the pipeline, or `set -o pipefail` reports it as a failure.
	if { ssh -o BatchMode=yes -o ConnectTimeout=5 -T git@github.com 2>&1 || true; } |
		grep -q 'successfully authenticated'; then
		row_grn OK github "ssh authenticates"
	else
		row_ylw WARN github "git@github.com did not authenticate (ssh key? network?)"
	fi
	"$root/scripts/deps.sh" check
	# Same two checks `up` offers to fix, in the mode that only ever reports.
	PREFIX="$PREFIX" "$root/scripts/session.sh" check
	return "$bad"
}

# ---- dispatch -------------------------------------------------------------
case "$sub" in
	up)
		phase_deps
		phase_sync
		phase_build
		phase_install
		phase_session
		phase_verify
		hdr "done"
		note "ensure $PREFIX/bin is on PATH, then start a session with ./test.sh"
		if [ "$verify_failed" = 1 ]; then
			warn "built and installed, but verify reported failures above"
			note "re-run scripts/verify.sh $CFG — the session checks can lose a"
			note "race on a cold cache and pass on a second run."
			exit 1
		fi
		;;
	status)  "$root/scripts/sync.sh" status ;;
	sync)    phase_sync ;;
	pin)     "$root/scripts/sync.sh" pin "${args[@]+"${args[@]}"}" ;;
	push)    "$root/scripts/sync.sh" push ;;
	deps)    "$root/scripts/deps.sh" install ;;
	boot)    "$root/scripts/boot.sh" "${args[@]+"${args[@]}"}" ;;
	net)     "$root/scripts/net.sh" "${args[@]+"${args[@]}"}" ;;
	session) PREFIX="$PREFIX" "$root/scripts/session.sh" "${args[@]+"${args[@]}"}" ;;
	doctor)  cmd_doctor ;;
	build)   phase_build ;;
	install) phase_install ;;
	verify)  "$root/scripts/verify.sh" "$CFG" ;;
	help)    usage ;;
	*) err "unknown subcommand: $sub (try --help)"; exit 2 ;;
esac
